# Read `man 5 sway` for a complete reference.
# Notification Daemon
exec swaync
exec emacs --daemon
exec /home/ebrasca/.guix-home/profile/libexec/xdg-desktop-portal-wlr; sleep 2; /home/ebrasca/.guix-home/profile/libexec/xdg-desktop-portal

### Variables
#
set $mod Mod4
set $term alacritty
set $menu wofi --show drun

#
# Status Bar:
# Read `man 5 sway-bar` for more information about this section.
#
bar {
  position top
  status_command while date +'%Y-%m-%d %T %A'; do sleep 1; done
  colors {
    statusline #ffffff
    background #323232
    inactive_workspace #32323200 #32323200 #5c5c5c
  }
}

### Output configuration
# You can get the names of your outputs by running: swaymsg -t get_outputs
output * bg /home/ebrasca/entre/anime/images/index.jpe fill
output HDMI-A-2 resolution 1920x1080 position 0,0
output HDMI-A-3 resolution 3840x2160 position 1920,1080

### Input configuration
# You can get the names of your inputs by running: swaymsg -t get_inputs
# Read `man 5 sway-input` for more information about this section.
input "type:keyboard" {
  xkb_layout us,es
  xkb_variant dvp,
  xkb_options grp:menu_toggle
}

input "type:tablet_tool" {
  map_to_output HDMI-A-3
}

### Key bindings
#
# Basics:
#
# Start a terminal
bindsym $mod+Return exec $term
# Kill focused window
bindsym $mod+k kill
# Start your launcher
bindsym $mod+x exec $menu
# Reload the configuration file
bindsym $mod+e reload
# Exit sway (logs you out of your Wayland session)
bindsym $mod+c exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'
#
# Moving around:
#
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+Left focus left
bindsym $mod+Right focus right

bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
#
# Workspaces:
#
# Switch to workspace
bindsym Control+F1 workspace number 1
bindsym Control+F2 workspace number 2
bindsym Control+F3 workspace number 3
bindsym Control+F4 workspace number 4
bindsym Control+F5 workspace number 5
bindsym Control+F6 workspace number 6
bindsym Control+F7 workspace number 7
bindsym Control+F8 workspace number 8
bindsym Control+F9 workspace number 9
bindsym Control+F10 workspace number 10
bindsym Control+F11 workspace number 11
bindsym Control+F12 workspace number 12
# Move focused container to workspace
bindsym $mod+F1 move container to workspace number 1
bindsym $mod+F2 move container to workspace number 2
bindsym $mod+F3 move container to workspace number 3
bindsym $mod+F4 move container to workspace number 4
bindsym $mod+F5 move container to workspace number 5
bindsym $mod+F6 move container to workspace number 6
bindsym $mod+F7 move container to workspace number 7
bindsym $mod+F8 move container to workspace number 8
bindsym $mod+F9 move container to workspace number 9
bindsym $mod+F10 move container to workspace number 10
bindsym $mod+F11 move container to workspace number 11
bindsym $mod+F12 move container to workspace number 12
#
# Screenshot
#
# Screenshot a monitor
bindsym Print exec grim -g "$(slurp -or)"
# Screenshot a window
# TODO:  bindsym $mod+Print exec sway-screenshot -m window
# Screenshot a region
bindsym $mod+Shift+Print exec grim -g "$(slurp -d)"
#
# Toggle control center
#
bindsym $mod+Shift+n exec swaync-client -t -sw
#
# Resizing containers:
#
# Make the current focus fullscreen
bindsym $mod+Shift+F11 fullscreen

# Resizing containers:
mode "resize" {
  # Ditto, with arrow keys
  bindsym Left resize shrink width 10px
  bindsym Down resize grow height 10px
  bindsym Up resize shrink height 10px
  bindsym Right resize grow width 10px
  # Return to default mode
  bindsym Return mode default
  bindsym Escape mode default
}
bindsym $mod+r mode "resize"
#
# wayvnc
#
mode "passthrough" {
  bindsym $mod+Pause mode default
}
bindsym $mod+Pause mode passthrough
